    // ─── QUIZ FLOW ────────────────────────────────────────────────────────────
    function startQuiz(){
      score=0;total=0;streak=0;qIdx=0;inProgress=true;locked=false;attempted=false;
      correctCount=0; correctionCount=0;
      mistakeLog=[];
      recentIds=[];
      feedbackEl.innerHTML="";hintEl.textContent="";
      updateScore();
      topicSel.disabled=true; modeSel.disabled=true;
      nextBtn.textContent="Next Question ▶"; nextBtn.disabled=true;
      $("sf-formula-details").open=false;
      $("sf-instructions").textContent=isTypeIn()
        ?"Type the formula (right-hand side only) using the keyboard below. (10 questions)"
        :"Memorise the formula — pick the correct one. You get 1 chance to self-correct if wrong. (10 questions)";
      nextQ();
    }

    function endQuiz(){
      stopTimer();inProgress=false;locked=true;attempted=false;
      topicSel.disabled=false; modeSel.disabled=false;
      metaEl.textContent=`Quiz finished (${TOTAL_QUESTIONS} questions)`;
      questionEl.textContent="—"; shapeEl.innerHTML="";
      optionsEl.innerHTML=""; hintEl.textContent="";
      hideTypeIn();
      timerEl.textContent=isWarmup()?"☕ Warm-Up (No Timer)":"⏱ –";
      const scoreStr = isWarmup() ? "–" : `${correctCount}C${correctionCount}`;
      feedbackEl.innerHTML = isWarmup()
        ? `✅ Warm-Up complete! (No score recorded.)`
        : `✅ Quiz complete! Final score: <strong>${scoreStr} / ${TOTAL_QUESTIONS}</strong>
           <br><small style="color:#a5b4fc;">${correctCount} correct first try + ${correctionCount} corrected on 2nd attempt</small>`;
      nextBtn.textContent="Restart Quiz ↻"; nextBtn.disabled=false;
      $("sf-formula-details").open=false;

      // Show mistake report button
      if (!isWarmup()) {
        const reportBtn = document.createElement("button");
        reportBtn.className = "sf-btn sf-secondary";
        reportBtn.textContent = "📋 View Mistake Report";
        reportBtn.style.marginLeft = "8px";
        reportBtn.addEventListener("click", showMistakeReport);
        feedbackEl.appendChild(document.createElement("br"));
        feedbackEl.appendChild(reportBtn);
      }
    }

    function resetQuiz(){
      stopTimer();inProgress=false;locked=false;attempted=false;
      score=0;total=0;streak=0;qIdx=0;recentIds=[];currentJumble=null;
      correctCount=0; correctionCount=0; mistakeLog=[];
      firstAttemptWrong=false; correctionUsed=false;
      topicSel.disabled=false; modeSel.disabled=false;
      hideTypeIn(); updateScore();
      metaEl.textContent="Ready";
      questionEl.textContent="—"; shapeEl.innerHTML="";
      optionsEl.innerHTML=""; hintEl.textContent="";
      timerEl.textContent=isWarmup()?"☕ Warm-Up (No Timer)":"⏱ –";
      feedbackEl.textContent="Choose your topic + mode, then press Start Quiz.";
      nextBtn.textContent="Start Quiz ▶"; nextBtn.disabled=false;
      $("sf-formula-details").open=false;
    }

    function nextQ(){
      if(!inProgress)return;
      if(qIdx>=TOTAL_QUESTIONS){endQuiz();return;}
      $("sf-formula-details").open=false;
      stopTimer();locked=false;attempted=false;
      firstAttemptWrong=false; correctionUsed=false;
      nextBtn.disabled=true;
      feedbackEl.innerHTML="";optionsEl.innerHTML="";hintEl.textContent="";insaneInput="";
      qIdx++;
      metaEl.textContent=`Question ${qIdx} of ${TOTAL_QUESTIONS}`;

      const base=pickQ();
      recentIds.push(base.id);
      if(recentIds.length>RECENT_LIMIT)recentIds.shift();

      const doJumble = isInsane();
      const doTypeIn = isTypeIn();
      currentJumble = doTypeIn ? makeJumble(base.id, doJumble) : null;

      current = doTypeIn ? Object.assign({}, base, {
        formula:    currentJumble.fullFormula,
        desc:       currentJumble.vars.map(v=>`${v.s} = ${v.n}`).join(", "),
      }) : base;

      questionEl.textContent = current.question;

      const svgArg = doTypeIn ? currentJumble.svgArg : false;
      shapeEl.innerHTML = shapeSVG(current.shape, svgArg);

      if(doTypeIn){
        showTypeIn();
      } else {
        hideTypeIn();
        buildOpts(base).forEach((opt,i)=>{
          const d=document.createElement("div");
          d.className="sf-option";
          d.dataset.correct=opt.id===base.id?"1":"0";
          d.dataset.formula=opt.formula;
          d.dataset.letter=LETTERS[i]||"?";
          d.innerHTML=`<div class="sf-letter">${LETTERS[i]||"?"}</div>
                       <div class="sf-opt-formula">${stripLHS(opt.formula)}</div>
                       <div class="sf-desc">${opt.desc}</div>`;
          d.addEventListener("click",()=>pick(d));
          optionsEl.appendChild(d);
        });
      }
      startTimer();
    }

    function revealCorrectCard(){
      optionsEl.querySelectorAll(".sf-option").forEach(c=>{
        if(c.dataset.correct==="1")c.classList.add("correct");
      });
    }

    function dimAllExcept(exceptCard){
      optionsEl.querySelectorAll(".sf-option").forEach(c=>{
        if(c!==exceptCard) c.classList.add("dimmed");
      });
    }

    // ─── MULTIPLE-CHOICE HANDLER ──────────────────────────────────────────────
    function pick(card){
      if(locked||!inProgress)return;
      const ok=card.dataset.correct==="1";
      const chosenFormula = stripLHS(card.dataset.formula || "");
      const chosenLetter  = card.dataset.letter || "";

      // ── WARM-UP ──
      if(isWarmup()){
        locked=true; attempted=true; nextBtn.disabled=false;
        card.classList.add(ok?"correct":"wrong");
        revealCorrectCard();
        if(ok){ feedbackEl.innerHTML="✅ Correct!"; confetti(2); play(aOk); }
        else  { feedbackEl.innerHTML=`❌ Not quite. ${revealBox(current.formula)}`; play(aBad); }
        return;
      }

      // ── FIRST ATTEMPT ──
      if(!firstAttemptWrong) {
        if(ok){
          // Correct on first try
          locked=true; attempted=true; nextBtn.disabled=false;
          stopTimer(); total++;
          const inTime=timeLeft>0;
          if(inTime){
            correctCount++; streak++;
            feedbackEl.innerHTML="✅ Correct!";
            card.classList.add("correct");
            confetti(3); play(aOk);
          } else {
            // After time out: half mark, still counts as correct (not correction)
            correctCount+=0.5; streak=0;
            feedbackEl.innerHTML="🟡 Correct (after time) — +0.5 pts.";
            card.classList.add("correct");
            confetti(1); play(aOk);
          }
          updateScore();
          revealCorrectCard();
        } else {
          // Wrong on first try — grant one correction chance
          firstAttemptWrong=true;
          card.classList.add("wrong");
          card.classList.add("dimmed");
          card.style.pointerEvents="none";
          feedbackEl.innerHTML=`❌ Wrong! <strong>One chance to correct yourself.</strong> Pick again.`;
          play(aBad);
          hintEl.textContent="⚠️ 1 correction chance remaining — choose carefully!";
          // Record the wrong answer details for potential mistake log
          card._wrongFormula = chosenFormula;
          card._wrongLetter  = chosenLetter;
        }
        return;
      }

      // ── CORRECTION ATTEMPT (second pick) ──
      if(firstAttemptWrong && !correctionUsed) {
        correctionUsed=true;
        locked=true; attempted=true; nextBtn.disabled=false;
        stopTimer(); total++;
        hintEl.textContent="";

        // Find what was selected wrong the first time
        const prevWrongCard = optionsEl.querySelector(".sf-option.wrong.dimmed");
        const prevWrongFormula = prevWrongCard ? stripLHS(prevWrongCard.dataset.formula||"") : "?";
        const prevWrongLetter  = prevWrongCard ? (prevWrongCard.dataset.letter||"?") : "?";

        if(ok){
          // Corrected successfully
          correctionCount++;
          streak=0;
          feedbackEl.innerHTML=`🟡 Corrected! <span class="sf-correction-badge">C</span> Corrected on 2nd attempt — counts as correction.`;
          card.classList.add("correct");
          confetti(1); play(aOk);
          // Not logged as a mistake since they eventually got it right (correction)
        } else {
          // Wrong again — no points, log as mistake
          streak=0;
          feedbackEl.innerHTML=`❌ Wrong again. ${revealBox(current.formula)}`;
          card.classList.add("wrong");
          play(aBad);
          // Log this mistake — use their second (final) wrong answer
          mistakeLog.push({
            qNum:      qIdx,
            question:  current.question,
            wrongFormula: `${prevWrongLetter}. ${prevWrongFormula} → ${chosenLetter}. ${chosenFormula}`,
            correctFormula: current.formula,
            wasCorrection: true,
          });
        }
        updateScore();
        revealCorrectCard();
        return;
      }
    }

    // ─── TYPE-IN SUBMIT HANDLER ───────────────────────────────────────────────
    function submitTypeIn(){
      if(locked||!inProgress)return;
      const ok = currentJumble ? checkTypeIn(currentJumble.accepted, insaneInput) : false;

      if(isWarmup()){
        locked=true; attempted=true; nextBtn.disabled=false;
        insaneDisp.classList.add(ok?"correct-flash":"wrong-flash");
        if(ok){ feedbackEl.innerHTML="✅ Correct!"; confetti(2); play(aOk); }
        else  { feedbackEl.innerHTML=`❌ Not quite. ${revealBox(current.formula)}`; play(aBad); }
        insaneSubmit.disabled=true; insaneClear.disabled=true;
        return;
      }

      // For type-in modes: no correction chance (1 shot) — log mistake if wrong
      attempted=true; nextBtn.disabled=false;
      const inTime=timeLeft>0;
      locked=true; stopTimer(); total++;

      if(inTime){
        if(ok){
          correctCount++;streak++;
          feedbackEl.innerHTML="✅ Correct! +1 pt";
          insaneDisp.classList.add("correct-flash");
          confetti(3); play(aOk);
        } else {
          streak=0;
          feedbackEl.innerHTML=`❌ Wrong. ${revealBox(current.formula)}`;
          insaneDisp.classList.add("wrong-flash");
          play(aBad);
          mistakeLog.push({
            qNum:      qIdx,
            question:  current.question,
            wrongFormula: insaneInput || "(blank)",
            correctFormula: current.formula,
            wasCorrection: false,
          });
        }
      } else {
        if(ok){
          correctCount+=0.5;streak=0;
          feedbackEl.innerHTML="🟡 Correct (after time) — +0.5 pts.";
          insaneDisp.classList.add("correct-flash");
          confetti(1); play(aOk);
        } else {
          streak=0;
          feedbackEl.innerHTML=`❌ Wrong (0 pts). ${revealBox(current.formula)}`;
          insaneDisp.classList.add("wrong-flash");
          play(aBad);
          mistakeLog.push({
            qNum:      qIdx,
            question:  current.question,
            wrongFormula: insaneInput || "(blank)",
            correctFormula: current.formula,
            wasCorrection: false,
          });
        }
      }
      updateScore();
      insaneSubmit.disabled=true; insaneClear.disabled=true;
    }

    // ─── FORMULA SHEET ────────────────────────────────────────────────────────
    function renderSheet(){
      const s=$("sf-sheet"); if(!s)return; s.innerHTML="";
      function sec(title,items){
        const c=document.createElement("div"); c.className="sf-sheet-card";
        c.innerHTML=`<div class="sf-sheet-title">${title}</div>`;
        items.forEach(it=>{
          const l=document.createElement("div"); l.className="sf-sheet-line";
          l.textContent=`${it.title}: ${it.formula}`; c.appendChild(l);
        });
        s.appendChild(c);
      }
      sec("2D Shapes",BANK.filter(x=>x.topic==="2d"));
      sec("3D Solids",BANK.filter(x=>x.topic==="3d"));
    }

    // ─── EVENTS ───────────────────────────────────────────────────────────────
    insaneSubmit.addEventListener("click", submitTypeIn);
    insaneClear.addEventListener("click", ()=>{
      if(locked)return;
      insaneInput=""; renderInsaneDisplay();
      insaneDisp.classList.remove("correct-flash","wrong-flash");
    });

    if(fmSummary){
      fmSummary.addEventListener("click", e=>{
        if(fmDetails.open)return;
        if(isWarmup())return;
        if(!window.confirm("⚠️ Opening the Formula Sheet deducts 1 mark.\n\nOpen it?"))
          {e.preventDefault();return;}
        if(inProgress){ correctCount-=1; updateScore(); feedbackEl.textContent="⚠️ −1 mark (Formula Sheet opened).";}
      });
    }

    nextBtn.addEventListener("click", ()=>{
      if(!inProgress){startQuiz();return;}
      if(!attempted){
        feedbackEl.textContent=isTypeIn()
          ?"⚠️ Please type and submit an answer first."
          :"⚠️ Please attempt this question first — no skipping.";
        return;
      }
      nextQ();
    });

    resetBtn.addEventListener("click", resetQuiz);
    modeSel.addEventListener("change", ()=>{
      if(!inProgress) timerEl.textContent=isWarmup()?"☕ Warm-Up (No Timer)":"⏱ –";
    });

    // ─── INIT ─────────────────────────────────────────────────────────────────
    renderSheet();
    resetQuiz();
  }

  if(document.readyState==="loading")
    document.addEventListener("DOMContentLoaded", initShapesFormulaGame);
  else
    initShapesFormulaGame();
})();
