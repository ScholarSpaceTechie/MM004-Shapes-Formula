      { id: "tri_area", topic: "2d", title: "Triangle — area", question: "Triangle: What is the formula for area?", formula: "A = ½bh", desc: "b = base, h = perpendicular height", hint: "Half of rectangle/parallelogram.", shape: "triangle" },
