    const nextBtn   = $("sf-next"),   resetBtn   = $("sf-reset");
    const fmDetails = $("sf-formula-details"), fmSummary=$("sf-formula-summary");

    // ─── STATE ────────────────────────────────────────────────────────────────
    let inProgress=false, locked=false, attempted=false;
    let score=0, total=0, streak=0, qIdx=0;
    let correctCount=0, correctionCount=0; // for C2 scoring
    let timerID=null, timeLeft=0;
    let current=null, recentIds=[], insaneInput="";
    let currentJumble=null;

    // ── Mistake report tracking ──
    // Each entry: { qNum, question, wrongOption, wrongFormula, correctFormula, wasCorrection }
    let mistakeLog = [];
    // Per-question correction state
    let firstAttemptWrong = false;   // true if student got it wrong first time
    let correctionUsed    = false;   // true if the 1 correction chance was used

    const isWarmup    = () => modeSel.value === "warmup";
    const isTypeIn    = () => modeSel.value === "superhard" || modeSel.value === "insane";
    const isSuperHard = () => modeSel.value === "superhard";
    const isInsane    = () => modeSel.value === "insane";

    // ─── AUDIO ────────────────────────────────────────────────────────────────
    const SFX = {
      ok:  "https://scholarspace.academy/wp-content/uploads/2026/01/Games-Correct1.mp3",
      bad: "https://scholarspace.academy/wp-content/uploads/2026/01/Games-Wrong1.mp3",
      tup: "https://scholarspace.academy/wp-content/uploads/2026/01/Games-Timeup1.mp3",
    };
    const aOk=new Audio(SFX.ok), aBad=new Audio(SFX.bad), aTup=new Audio(SFX.tup);
    [aOk,aBad,aTup].forEach(a=>{a.preload="auto";a.volume=0.55;});
    let audioReady=false;
    function unlockAudio(){
      if(audioReady)return; audioReady=true;
      [aOk,aBad,aTup].forEach(a=>{
        try{a.muted=true;const p=a.play();
          if(p&&p.then)p.then(()=>{a.pause();a.currentTime=0;a.muted=false;}).catch(()=>{a.muted=false;});
          else a.muted=false;
        }catch(e){}
      });
    }
    ["pointerdown","touchstart","click"].forEach(e=>document.addEventListener(e,unlockAudio,{once:true}));
    function play(a){try{a.currentTime=0;const p=a.play();if(p&&p.catch)p.catch(()=>{});}catch(e){}}

    // ─── CONFETTI ─────────────────────────────────────────────────────────────
    function confetti(intensity){
      const n=Math.max(12,Math.round(30*(intensity||1)));
      for(let i=0;i<n;i++){
        const s=document.createElement("span");
        s.className="sf-confetti";
        s.textContent=EMOJIS[Math.floor(Math.random()*EMOJIS.length)];
        s.style.left=Math.random()*100+"vw";
        s.style.top=Math.random()*5-10+"vh";
        s.style.animationDelay=Math.random()*.7+"s";
        s.style.animationDuration=1.4+Math.random()*.8+"s";
        document.body.appendChild(s);
        setTimeout(()=>s.remove(),2200);
      }
      const W=window.innerWidth||1200, H=window.innerHeight||800;
      const pop=(ox,oy,side,cnt)=>{
        let c=0;
        const iv=setInterval(()=>{
          if(c>=cnt){clearInterval(iv);return;}
          const sp=document.createElement("span");
          sp.className="sf-stream"; sp.textContent=EMOJIS[Math.floor(Math.random()*EMOJIS.length)];
          document.body.appendChild(sp);
          const sx=ox+(Math.random()-.5)*16, sy=oy+(Math.random()-.5)*16;
          const tx=W*.5+(Math.random()-.5)*W*.25, ty=H*.32+(Math.random()-.5)*H*.12;
          const cx=side==="left"?W*.28+Math.random()*W*.12:W*.72-Math.random()*W*.12;
          const cy=H*.12+Math.random()*H*.1;
          const t0=performance.now(), dur=900+Math.random()*350;
          (function anim(now){
            const tr=(now-t0)/dur; if(tr>=1){sp.remove();return;}
            const t=1-Math.pow(1-tr,2),u=1-t;
            sp.style.left=u*u*sx+2*u*t*cx+t*t*tx+"px";
            sp.style.top =u*u*sy+2*u*t*cy+t*t*ty+"px";
            sp.style.opacity=String(Math.max(0,t<.55?1:1-(t-.55)/.45));
            requestAnimationFrame(anim);
          })(performance.now());
          c++;
        },24);
      };
      const tps=20+Math.round(6*(intensity||1));
      pop(80,H-80,"left",tps); pop(W-80,H-80,"right",tps);
    }

    // ─── SCORE / TIMER ────────────────────────────────────────────────────────
    function updateScore(){
      // Display as "Score: 8C2 / 10" style
      const scoreStr = isWarmup()
        ? `Score: –`
        : `Score: ${correctCount}C${correctionCount} / ${total}`;
      scoreEl.textContent = scoreStr;
      streakEl.textContent=`Streak: ${streak} 🔥`;
    }
    function stopTimer(){if(timerID)clearInterval(timerID);timerID=null;}
    function startTimer(){
      stopTimer();
      const t=(DIFF[modeSel.value]||DIFF.normal).t;
      timeLeft=t;
      if(isWarmup()||t<=0){timerEl.textContent="☕ Warm-Up (No Timer)";return;}
      timerEl.textContent=`⏱ ${t}s`;
      timerID=setInterval(()=>{
        timeLeft--;
        timerEl.textContent=`⏱ ${Math.max(0,timeLeft)}s`;
        if(timeLeft<=0){stopTimer();onTimeUp();}
      },1000);
    }
    function onTimeUp(){
      if(locked||isWarmup()||!inProgress)return;
      feedbackEl.textContent=isTypeIn()
        ?"⏰ Time's up! Submit now for 0.5 pts."
        :"⏰ Time's up! You can still answer for 0.5 pts.";
      play(aTup);
    }

    // ─── POOL / PICKING ───────────────────────────────────────────────────────
    function pool(){
      const v=topicSel.value;
      return v==="2d"?BANK.filter(x=>x.topic==="2d"):
             v==="3d"?BANK.filter(x=>x.topic==="3d"):BANK.slice();
    }
    function pickQ(){
      const p=pool();
      for(let i=0;i<60;i++){const q=p[Math.floor(Math.random()*p.length)];if(!recentIds.includes(q.id))return q;}
      return p[Math.floor(Math.random()*p.length)];
    }
    function buildOpts(correct){
      const opts=[correct], seen=new Set([correct.id]);
      const topic=BANK.filter(x=>x.topic===correct.topic);
      function add(src){for(let i=0;i<400&&opts.length<OPTIONS_COUNT;i++){
        const c=src[Math.floor(Math.random()*src.length)];
        if(!seen.has(c.id)&&c.formula!==correct.formula){opts.push(c);seen.add(c.id);}
      }}
      add(topic); add(BANK);
      for(let i=opts.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[opts[i],opts[j]]=[opts[j],opts[i]];}
      return opts.slice(0,OPTIONS_COUNT);
    }
    function stripLHS(f){
      const m=String(f||"").trim().match(/^\s*(A|P|V|CSA|SA|L)\s*=\s*(.+)\s*$/i);
      return m?m[2].trim():String(f||"").trim();
    }

    // ─── KEYBOARD ─────────────────────────────────────────────────────────────
    const KB_DIGITS = [{l:"1",v:"1"},{l:"2",v:"2"},{l:"3",v:"3"},{l:"4",v:"4"},
      {l:"5",v:"5"},{l:"6",v:"6"},{l:"7",v:"7"},{l:"8",v:"8"},
      {l:"9",v:"9"},{l:"0",v:"0"},{l:".",v:"."},{l:"/",v:"/"},
      {l:"(",v:"("},{l:")",v:")"},{l:"⌫",v:"BS",c:"sf-key-backspace"}];
    const KB_SYMS = [{l:"π",v:"π",c:"sf-key-special"},{l:"²",v:"²",c:"sf-key-special"},
      {l:"³",v:"³",c:"sf-key-special"},{l:"½",v:"½",c:"sf-key-special"},
      {l:"⅓",v:"⅓",c:"sf-key-special"},{l:"×",v:"×",c:"sf-key-special"},
      {l:"÷",v:"÷",c:"sf-key-special"},{l:"+",v:"+"},{l:"-",v:"-"}];

    function buildKeyboard(){
      insaneKbEl.innerHTML="";
      const letterKeys = [];
      if(currentJumble){
        const seen=new Set();
        const source = currentJumble.keyVars || currentJumble.vars;
        source.forEach(v=>{
          const letter = String(v.s);
          if(!seen.has(letter)){
            seen.add(letter);
            const isSpecial = letter==="θ"||letter==="B"||letter.length>1;
            letterKeys.push({l:letter, v:letter, c: isSpecial?"sf-key-special":""});
          }
        });
      }

      const rows = [KB_DIGITS, letterKeys, KB_SYMS];
      rows.forEach(row=>{
        if(!row.length)return;
        const div=document.createElement("div");
        div.className="sf-kb-row";
        row.forEach(k=>{
          const btn=document.createElement("button");
          btn.type="button";
          btn.className="sf-key"+(k.c?" "+k.c:"");
          btn.textContent=k.l;
          btn.addEventListener("click",()=>{
            if(k.v==="BS")insaneInput=insaneInput.slice(0,-1);
            else insaneInput+=k.v;
            renderInsaneDisplay();
          });
          div.appendChild(btn);
        });
        insaneKbEl.appendChild(div);
      });
      const tip=document.createElement("div");
      tip.style.cssText="margin-top:6px;font-size:.82rem;color:#a5b4fc;";
      tip.innerHTML="Tip: Use <strong>π</strong> or <strong>pi</strong>, <strong>²</strong> or <strong>^2</strong>, <strong>³</strong> or <strong>^3</strong>. Spaces ignored.";
      insaneKbEl.appendChild(tip);
    }

    function renderInsaneDisplay(){
      insaneDisp.textContent=insaneInput.length?insaneInput:"|";
    }

    function buildVarLegend(){
      varLegendEl.innerHTML="";
      if(!currentJumble)return;
      currentJumble.vars.forEach(v=>{
        const chip=document.createElement("span");
        chip.className="sf-var-chip";
        chip.innerHTML=`<strong>${v.s}</strong> = ${v.n}`;
        varLegendEl.appendChild(chip);
      });
    }

    function showTypeIn(){
      optionsEl.style.display="none";
      insaneArea.style.display="block";
      insaneTitle.textContent = isInsane()
        ?"🔥 Jumbled letters! Type the formula (right-hand side only):"
        :"✏️ Type the formula (right-hand side only):";
      insaneInput="";
      renderInsaneDisplay();
      insaneDisp.classList.remove("correct-flash","wrong-flash");
      buildVarLegend();
      buildKeyboard();
      insaneSubmit.disabled=false;
      insaneClear.disabled=false;
    }

    function hideTypeIn(){
      insaneArea.style.display="none";
      optionsEl.style.display="grid";
    }

    // ─── CORRECT ANSWER REVEAL ────────────────────────────────────────────────
    function revealBox(formula){
      return `<span class="sf-correct-reveal">✔ Answer: ${formula}</span>`;
    }

    // ─── MISTAKE REPORT MODAL ─────────────────────────────────────────────────
    function buildReportText() {
      const mode = modeSel.options[modeSel.selectedIndex].text;
      const topic = topicSel.options[topicSel.selectedIndex].text;
      const scoreStr = `${correctCount}C${correctionCount} / ${TOTAL_QUESTIONS}`;
      let lines = [];
      lines.push(`📊 Shapes & Formulas Quiz Report`);
      lines.push(`Topic: ${topic} | Mode: ${mode}`);
      lines.push(`Final Score: ${scoreStr}`);
      lines.push(``);
      if (mistakeLog.length === 0) {
        lines.push(`🎉 Perfect score — no mistakes!`);
      } else {
        lines.push(`❌ Mistakes (${mistakeLog.length}):`);
        mistakeLog.forEach((m, i) => {
          lines.push(``);
          lines.push(`Q${m.qNum}: ${m.question}`);
          lines.push(`  ✗ Selected: ${m.wrongFormula}${m.wasCorrection ? " (2nd attempt)" : ""}`);
          lines.push(`  ✓ Correct: ${m.correctFormula}`);
        });
      }
      lines.push(``);
      lines.push(`— Shapes & Formula Game (MM004)`);
      return lines.join("\n");
    }

