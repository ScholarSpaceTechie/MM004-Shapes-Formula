      locked = false; // allow 0.5 marks after time up
      feedbackEl.textContent = "⏰ Time’s up! You can still answer for 0.5 points.";
      playTimeUpSound();
    }

    function pickPool() {
      const t = topicSel.value;
      if (t === "2d") return BANK.filter((x) => x.topic === "2d");
      if (t === "3d") return BANK.filter((x) => x.topic === "3d");
      return BANK.slice();
    }

    function pickQuestion() {
      const pool = pickPool();

      // try to avoid recent repeats
      for (let tries = 0; tries < 60; tries++) {
        const q = pool[Math.floor(Math.random() * pool.length)];
        if (!recentIds.includes(q.id)) return q;
      }
      return pool[Math.floor(Math.random() * pool.length)];
    }

    function buildOptions(correct) {
      // 4 options total (A-D)
      const opts = [correct];
      const seen = new Set([correct.id]);

      // Prefer distractors from same topic, then fall back to full bank
      const topicPool = BANK.filter((x) => x.topic === correct.topic);
      const fallbackPool = BANK;

      function addFrom(pool) {
        for (let tries = 0; tries < 200 && opts.length < 4; tries++) {
          const cand = pool[Math.floor(Math.random() * pool.length)];
          if (!seen.has(cand.id) && cand.formula !== correct.formula) {
            opts.push(cand);
            seen.add(cand.id);
          }
        }
      }

      addFrom(topicPool);
      addFrom(fallbackPool);

      // Shuffle
      for (let i = opts.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [opts[i], opts[j]] = [opts[j], opts[i]];
      }

      // Keep only 4
      return opts.slice(0, 4);
    }

    function renderFormulaSheet() {
      const sheet = document.getElementById("sf-sheet");
      if (!sheet) return;
      sheet.innerHTML = "";

      const twoD = BANK.filter((x) => x.topic === "2d");
      const threeD = BANK.filter((x) => x.topic === "3d");

      function addSection(title, items) {
        const card = document.createElement("div");
        card.className = "sf-sheet-card";
        card.innerHTML = `<div class="sf-sheet-title">${title}</div>`;
        items.forEach((it) => {
          const line = document.createElement("div");
          line.className = "sf-sheet-line";
          line.textContent = `${it.title}: ${it.formula}`;
          card.appendChild(line);
        });
        sheet.appendChild(card);
      }

      addSection("2D Shapes", twoD);
      addSection("3D Solids", threeD);
    }

    // ---------- GAME FLOW ----------
    function startQuiz() {
      score = 0;
      total = 0;
      streak = 0;
      qIndex = 0;
      inProgress = true;
      locked = false;

      recentIds = [];
      feedbackEl.textContent = "";
      hintEl.textContent = "";
      updateScore();

      topicSel.disabled = true;
      modeSel.disabled = true;

      nextBtn.textContent = "Next Question ▶";
      nextBtn.disabled = false;

      nextQuestion();
    }

    function endQuiz() {
      stopTimer();
      inProgress = false;
      locked = true;

      topicSel.disabled = false;
      modeSel.disabled = false;

      metaEl.textContent = `Quiz finished (${TOTAL_QUESTIONS} questions)`;
      questionEl.textContent = "—";
      hintEl.textContent = "";
      optionsEl.innerHTML = "";
      timerEl.textContent = isWarmup() ? "☕ Warm-Up (No Timer)" : "⏱ –";

      feedbackEl.textContent = isWarmup()
        ? "✅ Warm-Up complete! (No score recorded.)"
        : `✅ Quiz complete! Final score: ${score} / ${total}`;

      nextBtn.textContent = "Restart Quiz ↻";
      nextBtn.disabled = false;
    }

    function resetQuiz() {
      stopTimer();
      inProgress = false;
      locked = false;

      score = 0;
      total = 0;
      streak = 0;
      qIndex = 0;
      recentIds = [];

      topicSel.disabled = false;
      modeSel.disabled = false;

      updateScore();
      metaEl.textContent = "Ready";
      questionEl.textContent = "—";
      hintEl.textContent = "";
      optionsEl.innerHTML = "";
      timerEl.textContent = isWarmup() ? "☕ Warm-Up (No Timer)" : "⏱ –";
      feedbackEl.textContent = "Choose your topic + mode, then press Start Quiz.";
      nextBtn.textContent = "Start Quiz ▶";
      nextBtn.disabled = false;
    }

    function nextQuestion() {
      if (!inProgress) return;
      if (qIndex >= TOTAL_QUESTIONS) {
        endQuiz();
        return;
      }

      stopTimer();
      locked = false;
      feedbackEl.textContent = "";
      optionsEl.innerHTML = "";
      hintEl.textContent = "";

      qIndex++;
      metaEl.textContent = `Question ${qIndex} of ${TOTAL_QUESTIONS}`;

      current = pickQuestion();
      recentIds.push(current.id);
      if (recentIds.length > RECENT_LIMIT) recentIds.shift();

      questionEl.textContent = current.question;

      if (showHintsEl.checked) {
        hintEl.textContent = "💡 Memory hint: " + current.hint;
      } else {
        hintEl.textContent = "";
      }

      const opts = buildOptions(current);
      opts.forEach((opt, i) => {
        const btn = document.createElement("div");
        btn.className = "sf-option";
        btn.dataset.correct = opt.id === current.id ? "1" : "0";

        btn.innerHTML = `
          <div class="sf-letter">${letters[i]}</div>
          <div class="sf-formula">${opt.formula}</div>
          <div class="sf-desc">${opt.desc}</div>
        `;

        btn.addEventListener("click", () => handlePick(btn, opt));
        optionsEl.appendChild(btn);
      });

      startTimer();
    }

    function revealCorrectOption() {
      const cards = optionsEl.querySelectorAll(".sf-option");
      cards.forEach((c) => {
        if (c.dataset.correct === "1") c.classList.add("correct");
      });
    }

    function handlePick(card, picked) {
      if (locked || !inProgress) return;

      const isCorrect = card.dataset.correct === "1";

      // Warm-up: no score change
      if (isWarmup()) {
        locked = true;

        if (isCorrect) {
          feedbackEl.textContent = `✅ Correct! ${current.title}: ${current.formula}`;
          card.classList.add("correct");
          revealCorrectOption();
          launchConfetti(2);
          playCorrectSound();
        } else {
          feedbackEl.textContent = `❌ Not quite. Correct formula: ${current.formula}`;
          card.classList.add("wrong");
          revealCorrectOption();
          playWrongSound();
        }

        // Always show a quick “memorise” line
        if (showHintsEl.checked) {
          hintEl.textContent = "💡 Memory hint: " + current.hint;
        }
        return;
      }

      // Timed modes
      const withinTime = timeLeft > 0;

      locked = true;
      stopTimer();
      total++;

      if (withinTime) {
        if (isCorrect) {
          score += 1;
          streak++;
          feedbackEl.textContent = `✅ Correct! ${current.formula}`;
          card.classList.add("correct");
          launchConfetti(3);
          playCorrectSound();
        } else {
          streak = 0;
          feedbackEl.textContent = `❌ Wrong. Correct formula: ${current.formula}`;
          card.classList.add("wrong");
          playWrongSound();
        }
      } else {
        // After time up
        if (isCorrect) {
          score += 0.5;
          streak = 0;
          feedbackEl.textContent = `🟡 Correct (after time) → +0.5 pts. ${current.formula}`;
          card.classList.add("correct");
          launchConfetti(1);
          playCorrectSound();
        } else {
          streak = 0;
          feedbackEl.textContent = `❌ Wrong (0 pts). Correct formula: ${current.formula}`;
          card.classList.add("wrong");
          playWrongSound();
        }
      }

      updateScore();
      revealCorrectOption();

      // Nudge memorisation
      if (showHintsEl.checked) {
        hintEl.textContent = "💡 Memory hint: " + current.hint;
      }
    }

    // ---------- EVENTS ----------
    nextBtn.addEventListener("click", () => {
      if (!inProgress) {
        startQuiz();
      } else {
        nextQuestion();
      }
    });

    resetBtn.addEventListener("click", resetQuiz);

    modeSel.addEventListener("change", () => {
      if (!inProgress) {
        timerEl.textContent = isWarmup() ? "☕ Warm-Up (No Timer)" : "⏱ –";
      }
    });

    showHintsEl.addEventListener("change", () => {
      if (!inProgress) return;
      if (showHintsEl.checked && current) {
        hintEl.textContent = "💡 Memory hint: " + current.hint;
      } else {
        hintEl.textContent = "";
      }
    });

    // ---------- INIT ----------
    renderFormulaSheet();
    resetQuiz();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initShapesFormulaGame);
  } else {
    initShapesFormulaGame();
  }
})();
