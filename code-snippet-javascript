    [sfxCorrect, sfxWrong, sfxTimeUp].forEach(a => {
      a.preload = "auto";
      a.volume = 0.55;
    });

    // iPad/Safari: unlock audio on first user gesture
    let audioUnlocked = false;
    function unlockAudioOnce(){
      if (audioUnlocked) return;
      audioUnlocked = true;

      [sfxCorrect, sfxWrong, sfxTimeUp].forEach(a => {
        try{
          a.muted = true;
          const p = a.play();
          if (p && typeof p.then === "function"){
            p.then(() => {
              a.pause();
              a.currentTime = 0;
              a.muted = false;
            }).catch(() => {
              a.muted = false;
            });
          } else {
            a.muted = false;
          }
        } catch(e) {}
      });
    }
    document.addEventListener("pointerdown", unlockAudioOnce, { once: true });
    document.addEventListener("touchstart", unlockAudioOnce, { once: true });
    document.addEventListener("click", unlockAudioOnce, { once: true });

    function safePlay(audioEl){
      try{
        audioEl.currentTime = 0;
        const p = audioEl.play();
        if (p && typeof p.catch === "function") p.catch(()=>{});
      }catch(e){}
    }
    function playCorrectSound(){ safePlay(sfxCorrect); }
    function playWrongSound(){ safePlay(sfxWrong); }
    function playTimeUpSound(){ safePlay(sfxTimeUp); }

    // ---------- CONFETTI ----------
    function shootPopperStream(originX, originY, side, totalCount) {
      let count = 0;
      const interval = setInterval(() => {
        if (count >= totalCount) {
          clearInterval(interval);
          return;
        }

        const span = document.createElement("span");
        span.className = "sf-stream";
        span.textContent = emojis[Math.floor(Math.random() * emojis.length)];
        document.body.appendChild(span);

        const startX = originX + (Math.random() - 0.5) * 16;
        const startY = originY + (Math.random() - 0.5) * 16;

        const screenW = window.innerWidth || 1200;
        const screenH = window.innerHeight || 800;

        const targetX = screenW * 0.5 + (Math.random() - 0.5) * screenW * 0.25;
        const targetY = screenH * 0.32 + (Math.random() - 0.5) * screenH * 0.12;

        const controlX =
          side === "left"
            ? screenW * 0.28 + Math.random() * screenW * 0.12
            : screenW * 0.72 - Math.random() * screenW * 0.12;
        const controlY = screenH * 0.12 + Math.random() * screenH * 0.1;

        const startTime = performance.now();
        const duration = 900 + Math.random() * 350;

        function animate(now) {
          const elapsed = now - startTime;
          const tRaw = elapsed / duration;

          if (tRaw >= 1) {
            span.remove();
            return;
          }

          const t = 1 - Math.pow(1 - tRaw, 2);
          const u = 1 - t;

          const x = u * u * startX + 2 * u * t * controlX + t * t * targetX;
          const y = u * u * startY + 2 * u * t * controlY + t * t * targetY;

          span.style.left = x + "px";
          span.style.top = y + "px";

          let opacity;
          if (t < 0.55) opacity = 1;
          else opacity = 1 - (t - 0.55) / 0.45;

          span.style.opacity = String(Math.max(0, Math.min(1, opacity)));
          requestAnimationFrame(animate);
        }

        span.style.opacity = "1";
        requestAnimationFrame(animate);

        count++;
      }, 24);
    }

    function launchConfetti(intensity) {
      const base = 30;
      const factor = intensity || 1;
      const count = Math.max(12, Math.round(base * factor));

      for (let i = 0; i < count; i++) {
        const span = document.createElement("span");
        span.className = "sf-confetti";
        span.textContent = emojis[Math.floor(Math.random() * emojis.length)];
        span.style.left = Math.random() * 100 + "vw";
        span.style.top = Math.random() * 5 - 10 + "vh";
        span.style.animationDelay = Math.random() * 0.7 + "s";
        span.style.animationDuration = 1.4 + Math.random() * 0.8 + "s";
        document.body.appendChild(span);
        setTimeout(() => span.remove(), 2200);
      }

      const h = window.innerHeight || 800;
      const w = window.innerWidth || 1200;
      const totalPerSide = 20 + Math.round(6 * factor);
      shootPopperStream(80, h - 80, "left", totalPerSide);
      shootPopperStream(w - 80, h - 80, "right", totalPerSide);
    }

    // ---------- HELPERS ----------
    function getModeCfg() {
      return DIFF[modeSel.value] || DIFF.normal;
    }
    function isWarmup() {
      return modeSel.value === "warmup";
    }
    function updateScore() {
      scoreEl.textContent = `Score: ${score} / ${total}`;
      streakEl.textContent = `Streak: ${streak} 🔥`;
    }
    function stopTimer() {
      if (timerId) clearInterval(timerId);
      timerId = null;
    }
    function startTimer() {
      stopTimer();
      const cfg = getModeCfg();
      timeLeft = cfg.time;

      if (isWarmup() || cfg.time <= 0) {
        timerEl.textContent = "☕ Warm-Up (No Timer)";
        return;
      }

      timerEl.textContent = `⏱ ${timeLeft}s`;
      timerId = setInterval(() => {
        timeLeft--;
        if (timeLeft <= 0) {
          timeLeft = 0;
          timerEl.textContent = "⏱ 0s";
          stopTimer();
          timeUp();
        } else {
          timerEl.textContent = `⏱ ${timeLeft}s`;
        }
      }, 1000);
    }

    function timeUp() {
      if (locked || isWarmup() || !inProgress) return;
      locked = false;
      feedbackEl.textContent = "⏰ Time’s up! You can still answer for 0.5 points.";
      playTimeUpSound();
    }

    function pickPool() {
      const t = topicSel.value;
      if (t === "2d") return BANK.filter((x) => x.topic === "2d");
      if (t === "3d") return BANK.filter((x) => x.topic === "3d");
      return BANK.slice();
    }

    function pickQuestion() {
      const pool = pickPool();
      for (let tries = 0; tries < 60; tries++) {
        const q = pool[Math.floor(Math.random() * pool.length)];
        if (!recentIds.includes(q.id)) return q;
      }
      return pool[Math.floor(Math.random() * pool.length)];
    }

    function buildOptions(correct) {
      const opts = [correct];
      const seen = new Set([correct.id]);

      const topicPool = BANK.filter((x) => x.topic === correct.topic);
      const fallbackPool = BANK;

      function addFrom(pool) {
        for (let tries = 0; tries < 400 && opts.length < OPTIONS_COUNT; tries++) {
          const cand = pool[Math.floor(Math.random() * pool.length)];
          if (!seen.has(cand.id) && cand.formula !== correct.formula) {
            opts.push(cand);
            seen.add(cand.id);
          }
        }
      }

      addFrom(topicPool);
      addFrom(fallbackPool);

      // Shuffle
      for (let i = opts.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [opts[i], opts[j]] = [opts[j], opts[i]];
      }

      return opts.slice(0, OPTIONS_COUNT);
    }

    function renderFormulaSheet() {
      const sheet = document.getElementById("sf-sheet");
      if (!sheet) return;
      sheet.innerHTML = "";

      const twoD = BANK.filter((x) => x.topic === "2d");
      const threeD = BANK.filter((x) => x.topic === "3d");

      function addSection(title, items) {
        const card = document.createElement("div");
        card.className = "sf-sheet-card";
        card.innerHTML = `<div class="sf-sheet-title">${title}</div>`;
        items.forEach((it) => {
          const line = document.createElement("div");
          line.className = "sf-sheet-line";
          // Formula sheet keeps full formula (revision purpose)
          line.textContent = `${it.title}: ${it.formula}`;
          card.appendChild(line);
        });
        sheet.appendChild(card);
      }

      addSection("2D Shapes", twoD);
      addSection("3D Solids", threeD);
    }

    function closeFormulaSheet() {
      if (formulaDetails) formulaDetails.open = false;
    }

    function applyFormulaPenalty() {
      if (!inProgress) return;
      if (isWarmup()) return;

      score = score - 0.5;
      updateScore();
    }

    // ---------- GAME FLOW ----------
    function startQuiz() {
      score = 0;
      total = 0;
      streak = 0;
      qIndex = 0;
      inProgress = true;
      locked = false;
      attemptedThisQ = false;

      recentIds = [];
      feedbackEl.textContent = "";
      hintEl.textContent = ""; // no memory hints
      updateScore();

      topicSel.disabled = true;
      modeSel.disabled = true;

      nextBtn.textContent = "Next Question ▶";
      nextBtn.disabled = true; // cannot skip; enabled only after attempt

      closeFormulaSheet();
      nextQuestion();
    }

    function endQuiz() {
      stopTimer();
      inProgress = false;
      locked = true;
      attemptedThisQ = false;

      topicSel.disabled = false;
      modeSel.disabled = false;

      metaEl.textContent = `Quiz finished (${TOTAL_QUESTIONS} questions)`;
      questionEl.textContent = "—";
      shapeEl.innerHTML = "";
      hintEl.textContent = "";
      optionsEl.innerHTML = "";
      timerEl.textContent = isWarmup() ? "☕ Warm-Up (No Timer)" : "⏱ –";

      feedbackEl.textContent = isWarmup()
        ? "✅ Warm-Up complete! (No score recorded.)"
        : `✅ Quiz complete! Final score: ${score} / ${total}`;

      nextBtn.textContent = "Restart Quiz ↻";
      nextBtn.disabled = false;

      closeFormulaSheet();
    }

    function resetQuiz() {
      stopTimer();
      inProgress = false;
      locked = false;
      attemptedThisQ = false;

      score = 0;
      total = 0;
      streak = 0;
      qIndex = 0;
      recentIds = [];

      topicSel.disabled = false;
      modeSel.disabled = false;

      updateScore();
      metaEl.textContent = "Ready";
      questionEl.textContent = "—";
      shapeEl.innerHTML = "";
      hintEl.textContent = "";
      optionsEl.innerHTML = "";
      timerEl.textContent = isWarmup() ? "☕ Warm-Up (No Timer)" : "⏱ –";
      feedbackEl.textContent = "Choose your topic + mode, then press Start Quiz.";
      nextBtn.textContent = "Start Quiz ▶";
      nextBtn.disabled = false;

      closeFormulaSheet();
    }

    function nextQuestion() {
      if (!inProgress) return;
      if (qIndex >= TOTAL_QUESTIONS) {
        endQuiz();
        return;
      }

      // Ensure the Quick Formula is closed just before the next question shows up
      closeFormulaSheet();

      stopTimer();
      locked = false;
      attemptedThisQ = false;
      nextBtn.disabled = true;

      feedbackEl.textContent = "";
      optionsEl.innerHTML = "";
      hintEl.textContent = "";

      qIndex++;
      metaEl.textContent = `Question ${qIndex} of ${TOTAL_QUESTIONS}`;

      current = pickQuestion();
      recentIds.push(current.id);
      if (recentIds.length > RECENT_LIMIT) recentIds.shift();

      questionEl.textContent = current.question;
      shapeEl.innerHTML = shapeSVG(current.shape);

      const opts = buildOptions(current);
      opts.forEach((opt, i) => {
        const btn = document.createElement("div");
        btn.className = "sf-option";
        btn.dataset.correct = opt.id === current.id ? "1" : "0";

        // ✅ Remove "V =", "CSA =", etc in OPTIONS (no giveaway)
        const displayed = stripLeftSide(opt.formula);

        btn.innerHTML = `
          <div class="sf-letter">${letters[i] || "?"}</div>
          <div class="sf-formula">${displayed}</div>
          <div class="sf-desc">${opt.desc}</div>
        `;

        btn.addEventListener("click", () => handlePick(btn));
        optionsEl.appendChild(btn);
      });

      startTimer();
    }

    function revealCorrectOption() {
      const cards = optionsEl.querySelectorAll(".sf-option");
      cards.forEach((c) => {
        if (c.dataset.correct === "1") c.classList.add("correct");
      });
    }

    function handlePick(card) {
      if (locked || !inProgress) return;

      const isCorrect = card.dataset.correct === "1";
      attemptedThisQ = true;
      nextBtn.disabled = false;

      // Warm-up: no score change
      if (isWarmup()) {
        locked = true;

        if (isCorrect) {
          feedbackEl.textContent = `✅ Correct!`;
          card.classList.add("correct");
          revealCorrectOption();
          launchConfetti(2);
          playCorrectSound();
        } else {
          feedbackEl.textContent = `❌ Not quite. Correct formula: ${stripLeftSide(current.formula)}`;
          card.classList.add("wrong");
          revealCorrectOption();
          playWrongSound();
        }
        return;
      }

      // Timed modes
      const withinTime = timeLeft > 0;

      locked = true;
      stopTimer();
      total++;

      if (withinTime) {
        if (isCorrect) {
          score += 1;
          streak++;
          feedbackEl.textContent = `✅ Correct!`;
          card.classList.add("correct");
          launchConfetti(3);
          playCorrectSound();
        } else {
          streak = 0;
          feedbackEl.textContent = `❌ Wrong. Correct: ${stripLeftSide(current.formula)}`;
          card.classList.add("wrong");
          playWrongSound();
        }
      } else {
        // After time up
        if (isCorrect) {
          score += 0.5;
          streak = 0;
          feedbackEl.textContent = `🟡 Correct (after time) → +0.5 pts.`;
          card.classList.add("correct");
          launchConfetti(1);
          playCorrectSound();
        } else {
          streak = 0;
          feedbackEl.textContent = `❌ Wrong (0 pts). Correct: ${stripLeftSide(current.formula)}`;
          card.classList.add("wrong");
          playWrongSound();
        }
      }

      updateScore();
      revealCorrectOption();
    }

    // ---------- QUICK FORMULA SHEET RULES ----------
    // ✅ Requirement: warning BEFORE open (not after clicking open)
    // - Warm-Up: allowed (no penalty)
    // - Other modes: confirm -> if proceed, -0.5 marks and open
    if (formulaSummary) {
      formulaSummary.addEventListener("click", (e) => {
        // Only intercept opening action
        const willOpen = !formulaDetails.open;

        // If closing, allow
        if (!willOpen) return;

        // Warm-Up is free
        if (isWarmup()) return;

        // Not warm-up: confirm BEFORE opening
        // Also allow opening even if not inProgress, but no penalty unless inProgress
        const ok = window.confirm("⚠️ Opening Quick Formula Sheet will -0.5 marks.\n\nDo you want to open it?");
        if (!ok) {
          e.preventDefault();
          return;
        }

        // Apply penalty only during an active quiz
        if (inProgress) {
          applyFormulaPenalty();
          feedbackEl.textContent = "⚠️ -0.5 marks (Quick Formula Sheet opened).";
        }
      });
    }

    // ---------- EVENTS ----------
    nextBtn.addEventListener("click", () => {
      if (!inProgress) {
        startQuiz();
        return;
      }

      // Disable skipping questions without attempting
      if (!attemptedThisQ) {
        feedbackEl.textContent = "⚠️ No skipping: please attempt this question first.";
        return;
      }

      nextQuestion();
    });

    resetBtn.addEventListener("click", resetQuiz);

    modeSel.addEventListener("change", () => {
      if (!inProgress) {
        timerEl.textContent = isWarmup() ? "☕ Warm-Up (No Timer)" : "⏱ –";
      }
    });

    // ---------- INIT ----------
    renderFormulaSheet();
    resetQuiz();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initShapesFormulaGame);
  } else {
    initShapesFormulaGame();
  }
})();
