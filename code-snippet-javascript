    document.head.appendChild(style);

    // ─── CONSTANTS ────────────────────────────────────────────────────────────
    const LETTERS = ["A","B","C","D","E","F","G","H"];
    const EMOJIS  = ["🎉","🎊","🎈","✨","💫","🌟","🤩","💯","🥇","🥈","🥉"];
    const OPTIONS_COUNT   = 8;
    const TOTAL_QUESTIONS = 10;
    const RECENT_LIMIT    = 18;

    // ─── LETTER POOL FOR JUMBLING ─────────────────────────────────────────────
    const JPOOL = ["a","b","c","d","e","f","g","h","i","j","k","m","n","p","q","s","t","u","v","w","x","y","z"];

    function shuffle(arr) {
      const a = arr.slice();
      for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}
      return a;
    }

    function pickLetters(n, exclude) {
      const ex = new Set((exclude||[]).map(x=>x.toLowerCase()));
      const pool = JPOOL.filter(l=>!ex.has(l));
      return shuffle(pool).slice(0, n);
    }

    // ─── ALL-PERMUTATIONS HELPER ─────────────────────────────────────────────
    function allPerms(factors) {
      if (factors.length <= 1) return factors.length ? [factors[0]] : [""];
      const result = [];
      for (let i = 0; i < factors.length; i++) {
        const rest = factors.slice(0,i).concat(factors.slice(i+1));
        for (const tail of allPerms(rest)) result.push(factors[i] + tail);
      }
      return [...new Set(result)];
    }

    // ─── EXPAND WITH × VARIANTS ──────────────────────────────────────────────
    // Given an array of accepted strings, also add versions with explicit × or * between factors
    function withMultVariants(accepted) {
      const extras = [];
      accepted.forEach(s => {
        // Add version with explicit * between consecutive alphanumeric/special tokens
        // e.g. "πr²h" → also accept "π*r²*h", "π×r²×h"
        const starred = s.replace(/([a-zθπ²³½⅓0-9\)])\s*([a-zθπ(½⅓])/gi, '$1*$2');
        const crossed = s.replace(/([a-zθπ²³½⅓0-9\)])\s*([a-zθπ(½⅓])/gi, '$1×$2');
        if (starred !== s) extras.push(starred);
        if (crossed !== s) extras.push(crossed);
      });
      return [...new Set([...accepted, ...extras])];
    }

    // ─── PER-SHAPE JUMBLE GENERATORS ─────────────────────────────────────────
    function makeJumble(id, jumble) {
      function assign(originals, names, fixed) {
        const fixedSet = new Set((fixed||[]).map(s=>String(s)));
        const toJumble = originals.filter(l=>!fixedSet.has(String(l)));
        let assigned;
        if(jumble && toJumble.length > 0) {
          const exclude = originals.filter(l=>fixedSet.has(String(l)));
          const newLetters = pickLetters(toJumble.length, exclude);
          assigned = originals.map(l => fixedSet.has(String(l)) ? l : newLetters.shift());
        } else {
          assigned = originals.slice();
        }
        const map = {};
        originals.forEach((orig,i)=>{ map[orig]=assigned[i]; });
        const vars = originals.map((orig,i)=>({ s:assigned[i], n:names[i], orig }));
        return { map, vars, assigned };
      }

      switch(id) {

        // ── square ──
        case "sq_area":
        case "sq_per": {
          const {map,vars} = assign(["l"],["Side length"],[]);
          const L = map["l"];
          const areaAccepted = withMultVariants([`${L}²`,`${L}^2`,`${L}*${L}`,`${L}×${L}`,`${L}${L}`]);
          const perAccepted  = withMultVariants(allPerms(["4",L]).concat(allPerms(["4","*",L])).concat(allPerms(["4","×",L])))
            .concat([`${L}+${L}+${L}+${L}`]);
          return {
            map, vars,
            svgArg: { shape:"square", L },
            formula:     id==="sq_area" ? `${L}²`    : `4${L}`,
            fullFormula: id==="sq_area" ? `A = ${L}²` : `P = 4${L}`,
            accepted: id==="sq_area" ? areaAccepted : perAccepted,
          };
        }

        // ── rectangle ──
        case "rect_area":
        case "rect_per": {
          const {map,vars} = assign(["l","b"],["Length","Breadth"],[]);
          const L=map["l"], B=map["b"];
          const areaAccepted = withMultVariants(allPerms([L,B]));
          const perAccepted  = [
            `2(${L}+${B})`,`2(${B}+${L})`,`2${L}+2${B}`,`2${B}+2${L}`,
            `2*(${L}+${B})`,`2*(${B}+${L})`,`2×(${L}+${B})`,`2×(${B}+${L})`,
            // l+b+l+b style — all orderings of two L's and two B's summed
            `${L}+${B}+${L}+${B}`,`${L}+${L}+${B}+${B}`,
            `${B}+${L}+${B}+${L}`,`${B}+${B}+${L}+${L}`,
            `${L}+${B}+${B}+${L}`,`${B}+${L}+${L}+${B}`,
          ];
          return {
            map, vars,
            svgArg: { shape:"rectangle", L, B },
            formula:     id==="rect_area" ? `${L}${B}`        : `2(${L} + ${B})`,
            fullFormula: id==="rect_area" ? `A = ${L}${B}`    : `P = 2(${L} + ${B})`,
            accepted: id==="rect_area" ? areaAccepted : withMultVariants(perAccepted),
          };
        }

        // ── triangle ──
        case "tri_area": {
          const {map,vars} = assign(["b","h"],["Base","Height"],[]);
          const B=map["b"], H=map["h"];
          const fracs = ["½","1/2","0.5"];
          const base = fracs.flatMap(f => allPerms([f,B,H]))
            .concat([`${B}${H}/2`,`${H}${B}/2`,`${B}*${H}/2`,`${H}*${B}/2`,`${B}×${H}/2`,`${H}×${B}/2`]);
          return {
            map, vars,
            svgArg: { shape:"triangle", B, H },
            formula:     `½${B}${H}`,
            fullFormula: `A = ½${B}${H}`,
            accepted: withMultVariants(base),
          };
        }

        // ── trapezium ──
        case "trap_area": {
          const {map,vars} = assign(["a","b","c","d","e"],["Top parallel side","Bottom parallel side","Perpendicular height","Right slant side","Left slant side"],[]);
          const lTop=map["a"], lBot=map["b"], lH=map["c"], lSlant=map["d"], lSlant2=map["e"];
          const fracs = ["½","1/2","0.5"];
          const sums  = [`(${lTop}+${lBot})`,`(${lBot}+${lTop})`];
          // (a+b)/2 * c  style — sum first, then divide by 2, then multiply height
          const divStyle = sums.flatMap(s => [
            `${s}/2*${lH}`, `${s}/2×${lH}`, `${s}/2${lH}`,
            `${lH}*${s}/2`, `${lH}×${s}/2`, `${lH}${s}/2`,
          ]);
          const base = fracs.flatMap(f => sums.flatMap(s => allPerms([f,s,lH])))
            .concat(sums.flatMap(s => [`${s}${lH}/2`,`${s}*${lH}/2`,`${s}×${lH}/2`]))
            .concat(divStyle);
          return {
            map,
            vars: [],
            keyVars: [
              { s:lTop }, { s:lBot }, { s:lH }, { s:lSlant }, { s:lSlant2 },
            ],
            svgArg: { shape:"trapezium", lTop, lBot, lH, lSlant, lSlant2 },
            formula:     `½(${lTop} + ${lBot})${lH}`,
            fullFormula: `A = ½(${lTop} + ${lBot})${lH}`,
            accepted: withMultVariants(base),
          };
        }

        // ── sector ──
        case "sector_area":
        case "sector_arc": {
          const {map,vars} = assign(["r","θ"],["Radius","Angle (°)"],["θ"]);
          const R=map["r"];
          const piVars = ["π","pi"];
          const areaBase = piVars.flatMap(pi =>
            allPerms([`(θ/360)`,`${pi}`,`${R}²`])
            .concat(allPerms([`θ/360`,`${pi}`,`${R}²`]))
            .concat(allPerms([`θ÷360`,`${pi}`,`${R}²`]))
            .concat(allPerms([`(θ/360)`,`${pi}`,`${R}^2`]))
            .concat(allPerms([`θ/360`,`${pi}`,`${R}^2`]))
          );
          const arcBase = piVars.flatMap(pi =>
            allPerms([`(θ/360)`,`2`,`${pi}`,`${R}`])
            .concat(allPerms([`θ/360`,`2${pi}`,`${R}`]))
            .concat(allPerms([`θ÷360`,`2${pi}`,`${R}`]))
            .concat(allPerms([`(θ/360)`,`2${pi}`,`${R}`]))
          );
          return {
            map, vars,
            svgArg: { shape:"sector", R },
            formula:     id==="sector_area" ? `(θ/360)π${R}²`    : `(θ/360)2π${R}`,
            fullFormula: id==="sector_area" ? `A = (θ/360)π${R}²` : `L = (θ/360)2π${R}`,
            accepted: id==="sector_area"
              ? withMultVariants(areaBase)
              : withMultVariants(arcBase),
          };
        }

        // ── pyramid ──
        case "pyr_vol": {
          const {map,vars} = assign(["p","q","h","s"],["Base length","Base width","Height","Slant edge"],[]);
          const P=map["p"], Q=map["q"], H=map["h"];
          const fracs = ["⅓","1/3"];
          const pairs = [`${P}${Q}`,`${Q}${P}`,`${P}*${Q}`,`${Q}*${P}`,`${P}×${Q}`,`${Q}×${P}`];
          const parenPairs = pairs.map(pq=>`(${pq})`);
          // Also allow l*b*h style (using assigned letters)
          const lbhPerms = allPerms([P,Q,H]).concat(
            allPerms([P,Q,H]).map(s => s.replace(new RegExp(`(?<=[${P}${Q}${H}])(?=[${P}${Q}${H}])`,'g'),'*')),
            allPerms([P,Q,H]).map(s => s.replace(new RegExp(`(?<=[${P}${Q}${H}])(?=[${P}${Q}${H}])`,'g'),'×'))
          );
          const base = [
            ...fracs.flatMap(f => pairs.flatMap(pq  => allPerms([f,pq,H]))),
            ...fracs.flatMap(f => parenPairs.flatMap(pq => allPerms([f,pq,H]))),
            ...pairs.map(pq => `${pq}${H}/3`),
            ...pairs.map(pq => `(${pq})${H}/3`),
            ...pairs.map(pq => `${pq}*${H}/3`),
            ...pairs.map(pq => `${pq}×${H}/3`),
            // 1/3 * l * b * h style
            ...fracs.flatMap(f => lbhPerms.map(s => `${f}*${s}`)),
            ...fracs.flatMap(f => lbhPerms.map(s => `${f}${s}`)),
          ].filter((v,i,a)=>a.indexOf(v)===i);
          return {
            map, vars,
            svgArg: { shape:"pyramid", P, Q, H, S:map["s"] },
            formula:     `⅓(${P}×${Q})${H}`,
            fullFormula: `V = ⅓(${P}×${Q})${H}`,
            accepted: withMultVariants(base),
          };
        }

        // ── cone ──
        case "cone_vol":
        case "cone_csa": {
          const {map,vars} = assign(["r","h","l"],["Radius","Height","Slant height"],[]);
          const R=map["r"], H=map["h"], L=map["l"];
          const piVars = ["π","pi"];
          const volBase = ["⅓","1/3"].flatMap(f =>
            piVars.flatMap(pi => [
              ...allPerms([f,`${pi}`,`${R}²`,H]),
              ...allPerms([f,`${pi}`,`${R}^2`,H]),
              ...allPerms([f,`${pi}`,`${R}*${R}`,H]),
              ...allPerms([f,`${pi}`,`${R}×${R}`,H]),
            ])
          ).concat(
            piVars.flatMap(pi => [
              `${pi}${R}²${H}/3`,`${pi}${R}^2${H}/3`,
              `${pi}${H}${R}²/3`,`${pi}${H}${R}^2/3`,
              `${R}²${H}${pi}/3`,`${R}^2${H}${pi}/3`,
              `${pi}*${R}*${R}*${H}/3`,`${pi}×${R}×${R}×${H}/3`,
            ])
          );
          const csaBase = piVars.flatMap(pi => allPerms([`${pi}`,R,L]));
          return {
            map, vars,
            svgArg: { shape:"cone", R, H, L },
            formula:     id==="cone_vol" ? `⅓π${R}²${H}` : `π${R}${L}`,
            fullFormula: id==="cone_vol" ? `V = ⅓π${R}²${H}` : `CSA = π${R}${L}`,
            accepted: id==="cone_vol"
              ? withMultVariants(volBase)
              : withMultVariants(csaBase),
          };
        }

        // ── cuboid ──
        case "cuboid_vol":
        case "cuboid_sa": {
          const {map,vars} = assign(["l","b","h"],["Length","Breadth","Height"],[]);
          const L=map["l"], B=map["b"], H=map["h"];
          const volBase = allPerms([L,B,H]);
          const saBase = (()=>{
            const fp = [[L,B],[L,H],[B,H]];
            const facePairs = fp.map(([x,y])=>[`${x}${y}`,`${y}${x}`,`${x}*${y}`,`${y}*${x}`,`${x}×${y}`,`${y}×${x}`]);
            const results = [];
            for(const a of facePairs[0]) for(const b of facePairs[1]) for(const c of facePairs[2]) {
              const perms = [[a,b,c],[a,c,b],[b,a,c],[b,c,a],[c,a,b],[c,b,a]];
              for(const [x,y,z] of perms) {
                results.push(`2(${x}+${y}+${z})`);
                results.push(`2${x}+2${y}+2${z}`);
                results.push(`2*(${x}+${y}+${z})`);
                results.push(`2×(${x}+${y}+${z})`);
              }
            }
            return [...new Set(results)];
          })();
          return {
            map, vars,
            svgArg: { shape:"cuboid", L, B, H },
            formula:     id==="cuboid_vol" ? `${L}${B}${H}`               : `2(${L}${B} + ${L}${H} + ${B}${H})`,
            fullFormula: id==="cuboid_vol" ? `V = ${L}${B}${H}`           : `SA = 2(${L}${B} + ${L}${H} + ${B}${H})`,
            accepted: id==="cuboid_vol"
              ? withMultVariants(volBase)
              : withMultVariants(saBase),
          };
        }

        // ── cylinder ──
        case "cyl_vol":
        case "cyl_csa": {
          const {map,vars} = assign(["r","h"],["Radius","Height"],[]);
          const R=map["r"], H=map["h"];
          const piVars = ["π","pi"];
          const volBase = piVars.flatMap(pi => [
            ...allPerms([`${pi}`,`${R}²`,H]),
            ...allPerms([`${pi}`,`${R}^2`,H]),
            ...allPerms([`${pi}`,`${R}*${R}`,H]),
            ...allPerms([`${pi}`,`${R}×${R}`,H]),
          ]);
          const csaBase = piVars.flatMap(pi =>
            allPerms([`2${pi}`,R,H]).concat(allPerms([`2`,`${pi}`,R,H]))
          );
          return {
            map, vars,
            svgArg: { shape:"cylinder", R, H },
            formula:     id==="cyl_vol" ? `π${R}²${H}` : `2π${R}${H}`,
            fullFormula: id==="cyl_vol" ? `V = π${R}²${H}` : `CSA = 2π${R}${H}`,
            accepted: id==="cyl_vol"
              ? withMultVariants(volBase)
              : withMultVariants(csaBase),
          };
        }

        // ── sphere ──
        case "sphere_vol":
        case "sphere_sa": {
          const {map,vars} = assign(["r"],["Radius"],[]);
          const R=map["r"];
          const piVars = ["π","pi"];
          const volBase = piVars.flatMap(pi => [
            ...allPerms([`4/3`,`${pi}`,`${R}³`]),
            ...allPerms([`4/3`,`${pi}`,`${R}^3`]),
            ...allPerms([`(4/3)`,`${pi}`,`${R}³`]),
            ...allPerms([`(4/3)`,`${pi}`,`${R}^3`]),
            ...allPerms([`4/3`,`${pi}`,`${R}*${R}*${R}`]),
            `4${pi}${R}³/3`,`4${pi}${R}^3/3`,
            `${pi}*4*${R}³/3`,`4*${pi}*${R}³/3`,
          ]);
          const saBase = piVars.flatMap(pi => [
            ...allPerms([`4${pi}`,`${R}²`]),
            ...allPerms([`4${pi}`,`${R}^2`]),
            ...allPerms([`4`,`${pi}`,`${R}²`]),
            ...allPerms([`4`,`${pi}`,`${R}^2`]),
            ...allPerms([`4${pi}`,`${R}*${R}`]),
            ...allPerms([`4`,`${pi}`,`${R}*${R}`]),
          ]);
          return {
            map, vars,
            svgArg: { shape:"sphere", R },
            formula:     id==="sphere_vol" ? `4/3 π${R}³` : `4π${R}²`,
            fullFormula: id==="sphere_vol" ? `V = 4/3 π${R}³` : `SA = 4π${R}²`,
            accepted: id==="sphere_vol"
              ? withMultVariants(volBase)
              : withMultVariants(saBase),
          };
        }

        default: return { map:{}, vars:[], formula:"?", fullFormula:"?", accepted:[], svgArg:{shape:"square"} };
      }
    }

