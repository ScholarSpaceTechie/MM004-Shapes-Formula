      $("sf-formula-details").open=false;
    }

    function resetQuiz(){
      stopTimer();inProgress=false;locked=false;attempted=false;
      score=0;total=0;streak=0;qIdx=0;recentIds=[];
      topicSel.disabled=false; modeSel.disabled=false;
      hideInsane(); updateScore();
      metaEl.textContent="Ready";
      questionEl.textContent="—"; shapeEl.innerHTML="";
      optionsEl.innerHTML=""; hintEl.textContent="";
      timerEl.textContent=isWarmup()?"☕ Warm-Up (No Timer)":"⏱ –";
      feedbackEl.textContent="Choose your topic + mode, then press Start Quiz.";
      nextBtn.textContent="Start Quiz ▶"; nextBtn.disabled=false;
      $("sf-formula-details").open=false;
