          </svg>`;
        case "parallelogram":
          return `<svg viewBox="0 0 160 120">
            <polygon points="40,30 140,30 120,96 20,96" fill="${fill}" stroke="${stroke}" stroke-width="3"/>
          </svg>`;
        case "rhombus":
          return `<svg viewBox="0 0 160 120">
            <polygon points="80,20 140,60 80,100 20,60" fill="${fill}" stroke="${stroke}" stroke-width="3"/>
          </svg>`;
        case "kite":
          return `<svg viewBox="0 0 160 120">
