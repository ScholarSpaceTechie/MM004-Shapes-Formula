    function nextQ(){
      if(!inProgress)return;
      if(qIdx>=TOTAL_QUESTIONS){endQuiz();return;}
      $("sf-formula-details").open=false;
      stopTimer();locked=false;attempted=false;nextBtn.disabled=true;
      feedbackEl.innerHTML="";optionsEl.innerHTML="";hintEl.textContent="";insaneInput="";
      qIdx++;
      metaEl.textContent=`Question ${qIdx} of ${TOTAL_QUESTIONS}`;
      current=pickQ();
      recentIds.push(current.id);
      if(recentIds.length>RECENT_LIMIT)recentIds.shift();
      questionEl.textContent=current.question;
      shapeEl.innerHTML=shapeSVG(current.shape, isInsane());

      if(isInsane()){
        showInsane();
      } else {
        hideInsane();
        buildOpts(current).forEach((opt,i)=>{
          const d=document.createElement("div");
          d.className="sf-option";
          d.dataset.correct=opt.id===current.id?"1":"0";
          d.innerHTML=`<div class="sf-letter">${LETTERS[i]||"?"}</div>
                       <div class="sf-opt-formula">${stripLHS(opt.formula)}</div>
                       <div class="sf-desc">${opt.desc}</div>`;
          d.addEventListener("click",()=>pick(d));
          optionsEl.appendChild(d);
        });
      }
      startTimer();
    }

    function revealCorrectCard(){
      optionsEl.querySelectorAll(".sf-option").forEach(c=>{
        if(c.dataset.correct==="1")c.classList.add("correct");
      });
    }

    // ─── MULTIPLE-CHOICE HANDLER ──────────────────────────────────────────────
    function pick(card){
      if(locked||!inProgress)return;
      const ok=card.dataset.correct==="1";
      attempted=true; nextBtn.disabled=false;

      if(isWarmup()){
        locked=true;
        card.classList.add(ok?"correct":"wrong");
        revealCorrectCard();
        if(ok){
          feedbackEl.innerHTML="✅ Correct!";
          confetti(2); play(aOk);
        } else {
          feedbackEl.innerHTML=`❌ Not quite. ${revealBox(current.formula)}`;
          play(aBad);
        }
        return;
      }

      const inTime=timeLeft>0;
      locked=true; stopTimer(); total++;

      if(inTime){
        if(ok){
          score++;streak++;
          feedbackEl.innerHTML="✅ Correct!";
          card.classList.add("correct");
          confetti(3); play(aOk);
        } else {
          streak=0;
          feedbackEl.innerHTML=`❌ Wrong. ${revealBox(current.formula)}`;
          card.classList.add("wrong");
          play(aBad);
        }
      } else {
        if(ok){
          score+=0.5;streak=0;
          feedbackEl.innerHTML="🟡 Correct (after time) — +0.5 pts.";
          card.classList.add("correct");
          confetti(1); play(aOk);
        } else {
          streak=0;
          feedbackEl.innerHTML=`❌ Wrong (0 pts). ${revealBox(current.formula)}`;
          card.classList.add("wrong");
          play(aBad);
        }
      }
      updateScore();
      revealCorrectCard();
    }

    // ─── INSANE SUBMIT HANDLER ────────────────────────────────────────────────
    function submitInsane(){
      if(locked||!inProgress)return;
      const ok=checkInsane(current.id, insaneInput);
      attempted=true; nextBtn.disabled=false;

      if(isWarmup()){
        locked=true;
        insaneDisp.classList.add(ok?"correct-flash":"wrong-flash");
        if(ok){
          feedbackEl.innerHTML="✅ Correct!";
          confetti(2); play(aOk);
        } else {
          feedbackEl.innerHTML=`❌ Not quite. ${revealBox(current.formula)}`;
          play(aBad);
        }
        insaneSubmit.disabled=true; insaneClear.disabled=true;
        return;
      }

      const inTime=timeLeft>0;
      locked=true; stopTimer(); total++;

      if(inTime){
        if(ok){
          score++;streak++;
          feedbackEl.innerHTML="✅ Correct! +1 pt";
          insaneDisp.classList.add("correct-flash");
          confetti(3); play(aOk);
        } else {
          streak=0;
          feedbackEl.innerHTML=`❌ Wrong. ${revealBox(current.formula)}`;
          insaneDisp.classList.add("wrong-flash");
          play(aBad);
        }
      } else {
        if(ok){
          score+=0.5;streak=0;
          feedbackEl.innerHTML="🟡 Correct (after time) — +0.5 pts.";
          insaneDisp.classList.add("correct-flash");
          confetti(1); play(aOk);
        } else {
          streak=0;
          feedbackEl.innerHTML=`❌ Wrong (0 pts). ${revealBox(current.formula)}`;
          insaneDisp.classList.add("wrong-flash");
          play(aBad);
        }
      }
      updateScore();
      insaneSubmit.disabled=true; insaneClear.disabled=true;
    }

    // ─── FORMULA SHEET ────────────────────────────────────────────────────────
    function renderSheet(){
      const s=$("sf-sheet"); if(!s)return; s.innerHTML="";
      function sec(title,items){
        const c=document.createElement("div"); c.className="sf-sheet-card";
        c.innerHTML=`<div class="sf-sheet-title">${title}</div>`;
        items.forEach(it=>{
          const l=document.createElement("div"); l.className="sf-sheet-line";
          l.textContent=`${it.title}: ${it.formula}`; c.appendChild(l);
        });
        s.appendChild(c);
      }
      sec("2D Shapes",BANK.filter(x=>x.topic==="2d"));
      sec("3D Solids",BANK.filter(x=>x.topic==="3d"));
    }

    // ─── EVENTS ───────────────────────────────────────────────────────────────
    insaneSubmit.addEventListener("click", submitInsane);
    insaneClear.addEventListener("click", ()=>{
      if(locked)return;
      insaneInput=""; renderInsaneDisplay();
      insaneDisp.classList.remove("correct-flash","wrong-flash");
    });

    if(fmSummary){
      fmSummary.addEventListener("click", e=>{
        if(fmDetails.open)return;      // closing — allow
        if(isWarmup())return;          // warm-up — free
        if(!window.confirm("⚠️ Opening the Formula Sheet deducts 0.5 marks.\n\nOpen it?"))
          {e.preventDefault();return;}
        if(inProgress){
          score-=0.5; updateScore();
          feedbackEl.textContent="⚠️ −0.5 marks (Formula Sheet opened).";
        }
      });
    }

    nextBtn.addEventListener("click", ()=>{
      if(!inProgress){startQuiz();return;}
      if(!attempted){
        feedbackEl.textContent=isInsane()
          ?"⚠️ Please type and submit an answer first."
          :"⚠️ Please attempt this question first — no skipping.";
        return;
      }
      nextQ();
    });

    resetBtn.addEventListener("click", resetQuiz);
    modeSel.addEventListener("change", ()=>{
      if(!inProgress) timerEl.textContent=isWarmup()?"☕ Warm-Up (No Timer)":"⏱ –";
    });

    // ─── INIT ─────────────────────────────────────────────────────────────────
    renderSheet();
    resetQuiz();
  }

  if(document.readyState==="loading")
    document.addEventListener("DOMContentLoaded", initShapesFormulaGame);
  else
    initShapesFormulaGame();
})();
