          </svg>`;
        case "sector":
          return `<svg viewBox="0 0 120 120">
            <path d="M60 60 L60 20 A40 40 0 0 1 98 72 Z" fill="${fill}" stroke="${stroke}" stroke-width="3"/>
            <circle cx="60" cy="60" r="40" fill="none" stroke="${faint}" stroke-width="2"/>
          </svg>`;

        // ✅ Updated: Proper-looking square pyramid (isometric base + apex)
        case "pyramid":
          return `<svg viewBox="0 0 180 120">
            <!-- Base (parallelogram) -->
            <polygon points="45,85 115,85 150,100 80,100"
              fill="${fill}" stroke="${stroke}" stroke-width="3" />
            <!-- Back edge (faint for depth) -->
            <line x1="45" y1="85" x2="80" y2="100" stroke="${faint}" stroke-width="3" />
            <line x1="115" y1="85" x2="150" y2="100" stroke="${faint}" stroke-width="3" />
            <!-- Apex -->
            <circle cx="95" cy="28" r="2.5" fill="${stroke}" />
            <!-- Edges -->
            <line x1="95" y1="28" x2="45" y2="85" stroke="${stroke}" stroke-width="3" />
            <line x1="95" y1="28" x2="115" y2="85" stroke="${stroke}" stroke-width="3" />
            <line x1="95" y1="28" x2="150" y2="100" stroke="${faint}" stroke-width="3" />
            <line x1="95" y1="28" x2="80" y2="100" stroke="${stroke}" stroke-width="3" />
          </svg>`;

        case "cone":
          return `<svg viewBox="0 0 160 120">
            <ellipse cx="80" cy="92" rx="52" ry="16" fill="${fill}" stroke="${stroke}" stroke-width="3"/>
            <path d="M28 92 L80 18 L132 92" fill="${fill}" stroke="${stroke}" stroke-width="3"/>
