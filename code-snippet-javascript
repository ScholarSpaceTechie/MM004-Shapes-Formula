    // normalise user input & accepted answers before comparing
    function norm(s) {
      return String(s).toLowerCase()
        .replace(/\s+/g,"")
        .replace(/π/g,"pi").replace(/⅓/g,"1/3").replace(/½/g,"1/2")
        .replace(/÷/g,"/").replace(/×/g,"*")
        .replace(/\*+/g,"*")
        .replace(/²/g,"^2").replace(/³/g,"^3")
        .replace(/([a-zθ])2(?![0-9])/g,"$1^2")
        .replace(/([a-zθ])3(?![0-9])/g,"$1^3")
        .replace(/\*/g,"");
    }
    function checkInsane(id, input) {
      return (ACCEPTED[id]||[]).some(a => norm(a) === norm(input));
    }

    // ─── KEYBOARD ROWS ────────────────────────────────────────────────────────
    const KB = [
