    // ─── SVG DIAGRAMS ─────────────────────────────────────────────────────────
    // labelMode = true  →  draw algebra labels (yellow) on the shape (Insane mode)
    function shapeSVG(key, lm) {
      const S  = "rgba(255,255,255,.88)";   // shape stroke
      const F  = "rgba(255,255,255,.08)";   // shape fill
      const FA = "rgba(255,255,255,.22)";   // faint stroke (hidden edges)
      const LC = "#facc15";                  // label colour
      const DC = "rgba(250,204,21,.5)";     // dim-line colour
      const LS = "11";                       // label font-size

      // helper: yellow text label
      const T = (x,y,t,a) => `<text x="${x}" y="${y}" fill="${LC}" font-size="${LS}" font-weight="700" text-anchor="${a||"middle"}" font-family="sans-serif">${t}</text>`;
      // helper: dashed yellow dimension line
      const D = (x1,y1,x2,y2) => `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${DC}" stroke-width="1.5" stroke-dasharray="4,3"/>`;

      switch(key) {

        case "square": return `<svg viewBox="0 0 150 140">
          <rect x="20" y="18" width="90" height="90" rx="8" fill="${F}" stroke="${S}" stroke-width="3"/>
          ${lm?`${D(20,11,110,11)}${T(65,9,"l")}
                <line x1="116" y1="18" x2="116" y2="108" stroke="${DC}" stroke-width="1.5" stroke-dasharray="4,3"/>
                ${T(130,67,"l")}`:``}
        </svg>`;

        case "rectangle": return `<svg viewBox="0 0 190 120">
          <rect x="15" y="20" width="140" height="70" rx="8" fill="${F}" stroke="${S}" stroke-width="3"/>
          ${lm?`${D(15,13,155,13)}${T(85,10,"l")}
                ${D(161,20,161,90)}${T(175,58,"b")}`:``}
        </svg>`;

        case "triangle": return `<svg viewBox="0 0 190 140">
          <polygon points="15,115 95,15 175,115" fill="${F}" stroke="${S}" stroke-width="3"/>
          ${lm?`${D(15,123,175,123)}${T(95,133,"b")}
                ${D(95,15,95,115)}${T(110,70,"h")}`:``}
        </svg>`;

        case "trapezium": return `<svg viewBox="0 0 210 150">
          <polygon points="50,20 155,20 180,115 20,115" fill="${F}" stroke="${S}" stroke-width="3"/>
          ${lm?`
            ${D(50,12,155,12)}${T(102,9,"a")}
            ${D(20,125,180,125)}${T(100,136,"b")}
            <line x1="14" y1="20" x2="14" y2="115" stroke="${DC}" stroke-width="1.5" stroke-dasharray="4,3"/>
            ${T(5,72,"c","start")}
            <line x1="186" y1="20" x2="186" y2="115" stroke="${DC}" stroke-width="1.5" stroke-dasharray="4,3"/>
            ${T(198,72,"d","start")}
            ${D(160,12,185,12)}${T(185,9,"h","end")}
            <line x1="185" y1="12" x2="185" y2="115" stroke="${DC}" stroke-width="1.5" stroke-dasharray="4,3"/>
          `:``}
        </svg>`;

        case "circle": return `<svg viewBox="0 0 130 130">
          <circle cx="65" cy="65" r="48" fill="${F}" stroke="${S}" stroke-width="3"/>
          ${lm?`<line x1="65" y1="65" x2="113" y2="65" stroke="${DC}" stroke-width="1.5" stroke-dasharray="4,3"/>${T(89,58,"r")}`:``}
        </svg>`;

        case "sector": return `<svg viewBox="0 0 160 150">
          <path d="M80 90 L80 25 A65 65 0 0 1 143 115 Z" fill="${F}" stroke="${S}" stroke-width="3"/>
          <circle cx="80" cy="90" r="65" fill="none" stroke="${FA}" stroke-width="2"/>
          ${lm?`
            <line x1="80" y1="90" x2="80" y2="25" stroke="${LC}" stroke-width="1.8" stroke-dasharray="5,3"/>
            <line x1="80" y1="90" x2="143" y2="115" stroke="${LC}" stroke-width="1.8" stroke-dasharray="5,3"/>
            ${T(60,55,"r")}
            ${T(125,118,"r")}
            <path d="M80 68 A22 22 0 0 1 101 78" fill="none" stroke="${LC}" stroke-width="2"/>
            ${T(112,65,"θ")}
          `:``}
        </svg>`;

        case "pyramid": return `<svg viewBox="0 0 210 140">
          <polygon points="55,105 135,105 170,120 90,120" fill="${F}" stroke="${S}" stroke-width="3"/>
          <line x1="55"  y1="105" x2="90"  y2="120" stroke="${FA}" stroke-width="2.5"/>
          <line x1="135" y1="105" x2="170" y2="120" stroke="${FA}" stroke-width="2.5"/>
          <circle cx="112" cy="28" r="2.5" fill="${S}"/>
          <line x1="112" y1="28" x2="55"  y2="105" stroke="${S}" stroke-width="3"/>
          <line x1="112" y1="28" x2="135" y2="105" stroke="${S}" stroke-width="3"/>
          <line x1="112" y1="28" x2="170" y2="120" stroke="${FA}" stroke-width="2.5"/>
          <line x1="112" y1="28" x2="90"  y2="120" stroke="${S}" stroke-width="3"/>
          ${lm?`${D(112,28,112,112)}${T(124,74,"h")}
                ${T(105,133,"B = base area")}`:``}
        </svg>`;

        case "cone": return `<svg viewBox="0 0 200 140">
          <ellipse cx="100" cy="112" rx="68" ry="20" fill="${F}" stroke="${S}" stroke-width="3"/>
          <path d="M32 112 L100 20 L168 112" fill="${F}" stroke="${S}" stroke-width="3"/>
          ${lm?`${D(100,112,168,112)}${T(134,128,"r")}
                ${D(100,20,100,112)}${T(85,70,"h")}
                <line x1="100" y1="20" x2="168" y2="112" stroke="${LC}" stroke-width="1.2" stroke-dasharray="3,3" opacity=".7"/>
                ${T(145,58,"l")}`:``}
        </svg>`;

        case "cuboid": return `<svg viewBox="0 0 210 140">
          <path d="M30 50 L120 50 L155 25 L65 25 Z" fill="${F}" stroke="${S}" stroke-width="3"/>
          <path d="M30 50 L30 110 L120 110 L120 50 Z" fill="${F}" stroke="${S}" stroke-width="3"/>
          <path d="M120 50 L120 110 L155 85 L155 25 Z" fill="${F}" stroke="${S}" stroke-width="3"/>
          ${lm?`${D(30,117,120,117)}${T(75,128,"l")}
                ${D(126,50,126,110)}${T(137,83,"h")}
                ${D(120,110,155,85)}${T(150,106,"b")}`:``}
        </svg>`;

        case "cylinder": return `<svg viewBox="0 0 190 140">
          <ellipse cx="95" cy="28" rx="58" ry="20" fill="${F}" stroke="${S}" stroke-width="3"/>
          <line x1="37" y1="28" x2="37" y2="108" stroke="${S}" stroke-width="3"/>
          <line x1="153" y1="28" x2="153" y2="108" stroke="${S}" stroke-width="3"/>
          <ellipse cx="95" cy="108" rx="58" ry="20" fill="${F}" stroke="${S}" stroke-width="3"/>
          ${lm?`${D(95,28,153,28)}${T(124,20,"r")}
                ${D(159,28,159,108)}${T(173,72,"h")}`:``}
        </svg>`;

        case "sphere": return `<svg viewBox="0 0 140 140">
          <circle cx="70" cy="70" r="55" fill="${F}" stroke="${S}" stroke-width="3"/>
          <ellipse cx="70" cy="70" rx="55" ry="20" fill="none" stroke="${FA}" stroke-width="2"/>
          <ellipse cx="70" cy="70" rx="22" ry="55" fill="none" stroke="rgba(255,255,255,.15)" stroke-width="2"/>
          ${lm?`<line x1="70" y1="70" x2="70" y2="15" stroke="${DC}" stroke-width="1.5" stroke-dasharray="4,3"/>
                ${T(53,44,"r")}`:``}
        </svg>`;

        default: return `<svg viewBox="0 0 120 120">
          <rect x="20" y="20" width="80" height="80" rx="10" fill="${F}" stroke="${S}" stroke-width="3" opacity=".6"/>
        </svg>`;
      }
    }

    // ─── FORMULA BANK ─────────────────────────────────────────────────────────
    // vars: [{s: algebra symbol, n: full word}]  — shown as chips in Insane mode
    const BANK = [
      // ── 2D ──
      {id:"sq_area",    topic:"2d", title:"Square — area",
       question:"Square: What is the formula for area?",
       formula:"A = l²",            desc:"l = side length",
       shape:"square",   vars:[{s:"l",n:"Side length"}]},

      {id:"sq_per",     topic:"2d", title:"Square — perimeter",
       question:"Square: What is the formula for perimeter?",
       formula:"P = 4l",            desc:"l = side length",
       shape:"square",   vars:[{s:"l",n:"Side length"}]},

      {id:"rect_area",  topic:"2d", title:"Rectangle — area",
       question:"Rectangle: What is the formula for area?",
       formula:"A = lb",            desc:"l = length, b = breadth",
       shape:"rectangle",vars:[{s:"l",n:"Length"},{s:"b",n:"Breadth"}]},

      {id:"rect_per",   topic:"2d", title:"Rectangle — perimeter",
       question:"Rectangle: What is the formula for perimeter?",
       formula:"P = 2(l + b)",      desc:"l = length, b = breadth",
       shape:"rectangle",vars:[{s:"l",n:"Length"},{s:"b",n:"Breadth"}]},

      {id:"trap_area",  topic:"2d", title:"Trapezium — area",
       question:"Trapezium: What is the formula for area?",
       formula:"A = ½(a + b)h",     desc:"a, b = parallel sides, h = height",
       shape:"trapezium",vars:[{s:"a",n:"Top side"},{s:"b",n:"Bottom side"},{s:"h",n:"Height"}]},

      {id:"tri_area",   topic:"2d", title:"Triangle — area",
       question:"Triangle: What is the formula for area?",
       formula:"A = ½bh",           desc:"b = base, h = height",
       shape:"triangle", vars:[{s:"b",n:"Base"},{s:"h",n:"Height"}]},

      {id:"sector_area",topic:"2d", title:"Sector — area",
       question:"Circle sector: What is the formula for area (θ in degrees)?",
       formula:"A = (θ/360)πr²",    desc:"θ = central angle (°), r = radius",
       shape:"sector",   vars:[{s:"r",n:"Radius"},{s:"θ",n:"Angle (°)"}]},

      {id:"sector_arc", topic:"2d", title:"Sector — arc length",
       question:"Circle sector: What is the formula for arc length (θ in degrees)?",
       formula:"L = (θ/360)2πr",    desc:"θ = central angle (°), r = radius",
       shape:"sector",   vars:[{s:"r",n:"Radius"},{s:"θ",n:"Angle (°)"}]},

      // ── 3D ──
      {id:"pyr_vol",    topic:"3d", title:"Pyramid — volume",
       question:"Pyramid (any base): What is the formula for volume?",
       formula:"V = ⅓Bh",           desc:"B = base area, h = height",
       shape:"pyramid",  vars:[{s:"B",n:"Base area"},{s:"h",n:"Height"}]},

