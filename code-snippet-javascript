    // normalise for comparison
    function norm(s) {
      return String(s).toLowerCase()
        .replace(/\s+/g,"")
        .replace(/π/g,"pi").replace(/⅓/g,"1/3").replace(/½/g,"1/2")
        .replace(/÷/g,"/").replace(/×/g,"*")
        .replace(/\*+/g,"*")
        .replace(/²/g,"^2").replace(/³/g,"^3")
        .replace(/([a-zθ])2(?![0-9])/g,"$1^2")
        .replace(/([a-zθ])3(?![0-9])/g,"$1^3")
        .replace(/\*/g,"");
    }

    function checkTypeIn(accepted, input) {
      const n = norm(input);
      return accepted.some(a => norm(a) === n);
    }

